# Copy this file to .env and adjust as needed.

# Port the Express server listens on
# (5050 is used here because macOS AirPlay already listens on 5000)
PORT=5050

# Secret used to sign JWT tokens (change this in a real deployment)
JWT_SECRET=unstuck_dev_secret_change_me

# How long a login session stays valid
JWT_EXPIRES_IN=7d

# MongoDB connection string.
# Leave this EMPTY to let the server start a temporary in-memory MongoDB
# automatically (handy for demos / viva). Set it to a real instance for
# permanent data, for example:
#   mongodb://127.0.0.1:27017/unstuck
#   mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/unstuck
MONGO_URI=

# Frontend origin allowed by CORS
CLIENT_ORIGIN=http://localhost:5173

# Gemini API key. THIS IS REQUIRED for the app to work.
# The app writes every troubleshooting step with Gemini, so without a key
# a new session cannot start: it ends as "escalated" and says plainly that
# no key is configured. Nothing is invented to fill the gap.
# Get one from https://aistudio.google.com/app/apikey
# Keep it here, on the server. Never put it in the client, never prefix it
# with VITE_, and never commit this file.
GEMINI_API_KEY=

# Gemini model used for generating steps.
# gemini-2.0-flash was retired by Google on 1 June 2026 and no longer works,
# so it must not be used here. Set any model your key can reach.
#
# The free tier gives only 20 requests per day PER MODEL, and each model has
# its own separate allowance. That means if one model runs dry you can switch
# to another and get a fresh 20, so the lite models are a good default here.
GEMINI_MODEL=gemini-3.5-flash-lite
